// | where ResourceProvider == "MICROSOFT.SEARCH"
// | extend StatusCode = toint(resultSignature_d)
// | where StatusCode >= 400 or StatusCode == 206
// | project TimeGenerated, StatusCode, OperationName, IndexName_s, Description_s, Query_s, Documents_d, DurationMs, ResultType
